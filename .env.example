# Copy this file to .env and fill in your values.
# .env is git-ignored and should never be committed.

# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Scripts only (eval + ingestion) — never shipped in the app bundle
# OPENAI_API_KEY=sk-...
# SUPABASE_SERVICE_ROLE_KEY=...   # writes; required for kb:ingest (not dry-run)

# Migrations only. A personal access token (sbp_...) from
# https://supabase.com/dashboard/account/tokens — NOT the service-role key,
# which is a PostgREST JWT and cannot run DDL.
# SUPABASE_ACCESS_TOKEN=sbp_...
