# The research evaluation harness is frozen with the report whose results it
# produced: its item files and fixtures are cited there by path, and some are
# large generated data. Reformatting would churn all of them for no gain.
scripts/eval

# Entry documents carry inline scripts whose hashes are pinned in the Content
# Security Policy (vercel.json). Reformatting one changes its hash, and the
# browser then refuses to run it.
*.html

