# Copy to .env (git-ignored).

# Origin of the backend (the dementiaguide-api Vercel project). Required in
# production builds; for local dev point it at a `vercel dev` instance run
# from apps/api, or at the deployed API directly.
VITE_API_BASE_URL=

# Same Supabase project as apps/web/apps/mobile. The anon key is public by
# design (it's inlined into this bundle either way) — it can only start a
# login, never write knowledge_chunks; the actual gate is apps/api's
# ADMIN_ALLOWED_EMAILS, checked server-side against the verified session.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
