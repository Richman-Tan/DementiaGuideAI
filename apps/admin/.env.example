# Copy to .env (git-ignored).

# Origin of the backend (the dementiaguide-api Vercel project). Required in
# production builds; for local dev point it at a `vercel dev` instance run
# from apps/api, or at the deployed API directly.
VITE_API_BASE_URL=

# The admin token itself is NOT an env var on purpose — it's entered at
# runtime and kept in sessionStorage only, never baked into the build (every
# VITE_ variable here is inlined into the browser bundle and would ship to
# anyone who opens this app). See apps/api/.env.example's ADMIN_INGEST_TOKENS.
