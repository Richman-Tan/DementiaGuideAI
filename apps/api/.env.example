# Backend service (apps/api). Copy to .env for `vercel dev`, or set these in the
# Vercel project — they are read by the API service only.
#
# NEVER prefix any of these with VITE_: that would inline them into the browser
# bundle and defeat the entire point of holding credentials server-side.

# Credentials the proxy holds on callers' behalf. Set a HARD SPEND CAP on
# the OpenAI account before issuing any code — it is the real backstop, not the
# per-code meter.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ─── The assistant (POST /api/turn) ──────────────────────────────────────────
#
# The answering pipeline runs on these two keys. Set a HARD SPEND LIMIT on the
# Anthropic account before switching the endpoint on: the daily limits below
# count turns, and the provider's own limit is the backstop.
ANTHROPIC_API_KEY=

# Embeddings for search (Voyage AI). A MongoDB Atlas "model API key" works as
# is. For a key issued at voyageai.com, also set
# VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_API_KEY=

# The endpoint answers 503 until this is exactly "on" and the keys above and
# the Supabase settings below are all present. Leave it empty until the
# knowledge base has been re-embedded (see this app's README).
TURN_ENDPOINT=

# Turns per UTC day: for one visitor, and for everyone together. The second is
# the cap on what a day can cost; the README works through the arithmetic.
TURN_VISITOR_DAILY_LIMIT=20
TURN_GLOBAL_DAILY_LIMIT=100

# Optional. The model that writes answers (default claude-opus-5-5), the
# database search function (default match_chunks_v2), and Voyage reranking
# (off unless "on").
# PIPELINE_MODEL=
# KB_SEARCH_FUNCTION=
# KB_RERANK=

# ─── The older proxies ───────────────────────────────────────────────────────

# Comma-separated access codes. Make them unguessable — they are the only thing
# standing between a stranger and your OpenAI bill. Generate with:
#   openssl rand -hex 16
#
# One code per person is the safer shape: the daily meter below is keyed on
# the code, so separate codes give each person their own allowance and let you
# revoke one without disrupting the rest. A single shared code works
# and is simpler to distribute, but then the limit is a pool everyone draws from
# and a leak cannot be contained to one person.
STUDY_ACCESS_CODES=

# Requests per code per UTC day. It bounds the damage from a leaked code; it is
# NOT the spend control — set a hard cap on the OpenAI account for that.
STUDY_DAILY_REQUEST_LIMIT=4000

# Service-role key for the server-side tables. The anonymous key above is denied
# access to them by row-level security, on purpose.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to call this API from a browser. This deploys
# as its own project, so every browser call is cross-origin and anything not
# listed here is refused by CORS.
#
# List the exact web origins — the production domain, and any preview domain you
# actually test from. Never `*`: the access code travels in a request
# header, and a wildcard would let any page open in a visitor's browser use
# it. Missing or wrong values look exactly like "the backend is down".
#
# Include the admin intake app's origin too (dementiaguide-admin.vercel.app) —
# it shares this allowlist with the web origins.
ALLOWED_ORIGINS=https://your-web-app.vercel.app

# Comma-separated, case-insensitive allowlist for the knowledge-base admin
# intake endpoint (api/admin/ingest.js). Auth there is a real Supabase Auth
# login (apps/admin's magic-link sign-in), verified server-side against
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above — being an authenticated
# Supabase user is NOT enough on its own, since this writes directly into
# the production knowledge base. Only emails listed here are let through.
#
# Each email also needs its own Supabase Auth user created ahead of time
# (Dashboard → Authentication → Users → Add user), with sign-ups otherwise
# disabled for that flow (apps/admin passes shouldCreateUser: false) — so
# someone typing an arbitrary email on the login screen can't self-register.
ADMIN_ALLOWED_EMAILS=
