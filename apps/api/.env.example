# Backend service (apps/api). Copy to .env for `vercel dev`, or set these in the
# Vercel project — they are read by the API service only.
#
# NEVER prefix any of these with VITE_: that would inline them into the browser
# bundle and defeat the entire point of holding credentials server-side.

# Credentials the proxy holds on participants' behalf. Set a HARD SPEND CAP on
# the OpenAI account before any session — it is the real backstop, not the
# per-code meter (docs/study/pilot-checklist.md §1).
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Comma-separated access codes. Make them unguessable — they are the only thing
# standing between a stranger and your OpenAI bill. Generate with:
#   openssl rand -hex 16
#
# One code per participant is the safer shape: the daily meter below is keyed on
# the code, so separate codes give each person their own allowance and let you
# revoke one participant without disrupting the rest. A single shared code works
# and is simpler to distribute, but then the limit is a pool everyone draws from
# and a leak cannot be contained to one person.
STUDY_ACCESS_CODES=

# Requests per code per UTC day. A full session is roughly 30–60 requests, so
# this is sized for a whole cohort in one evening on a shared code rather than
# per person. It bounds the damage from a leaked code; it is NOT the spend
# control — set a hard cap on the OpenAI account for that
# (docs/study/pilot-checklist.md §1).
STUDY_DAILY_REQUEST_LIMIT=4000

# Service-role key for the study tables. The anonymous key above is denied
# access to them by row-level security, on purpose
# (docs/study/ethics/data-management-plan.md §4).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to call this API from a browser. This deploys
# as its own project, so every browser call is cross-origin and anything not
# listed here is refused by CORS.
#
# List the exact web origins — the production domain, and any preview domain you
# actually test from. Never `*`: the study access code travels in a request
# header, and a wildcard would let any page open in a participant's browser use
# it. Missing or wrong values look exactly like "the backend is down".
ALLOWED_ORIGINS=https://your-web-app.vercel.app
