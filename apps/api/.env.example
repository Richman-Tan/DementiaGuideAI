# Backend service (apps/api). Copy to .env for `vercel dev`, or set these in the
# Vercel project — they are read by the API service only.
#
# NEVER prefix any of these with VITE_: that would inline them into the browser
# bundle and defeat the entire point of holding credentials server-side.

# Credentials the proxy holds on participants' behalf. Set a HARD SPEND CAP on
# the OpenAI account before any session — it is the real backstop, not the
# per-code meter (docs/study/pilot-checklist.md §1).
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Comma-separated access codes, one per participant, issued in the invitation.
# Make them unguessable — they are the only thing standing between a stranger
# and your OpenAI bill.
STUDY_ACCESS_CODES=

# Per-code requests per UTC day. A full session is roughly 30–60 requests.
STUDY_DAILY_REQUEST_LIMIT=400

# Service-role key for the study tables. The anonymous key above is denied
# access to them by row-level security, on purpose
# (docs/study/ethics/data-management-plan.md §4).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
