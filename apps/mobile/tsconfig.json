{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // packages/core imports its own modules as ./x.ts so that plain Node can run
    // it without a build; nothing is emitted here, so that is allowed.
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["../../packages/core/*"],
      "@assets/*": ["../../assets/*"]
    }
  },
  "include": ["index.js", "App.js", "src/**/*", "../../packages/core/**/*"],
  "exclude": ["node_modules", "modules", "plugins", "dist", ".expo"]
}
