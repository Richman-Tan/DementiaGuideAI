{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["../../packages/core/*"],
      "@assets/*": ["../../assets/*"]
    }
  },
  "include": ["index.js", "App.js", "src/**/*", "../../packages/core/**/*"],
  "exclude": ["node_modules", "modules", "plugins", "dist", ".expo"]
}
