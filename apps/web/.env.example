# Copy to .env (git-ignored). Values mirror the mobile app's EXPO_PUBLIC_* vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: force mock services even when API keys are stored (also: ?mock=1)
VITE_FORCE_MOCK=

# Server-side credentials now live with the backend — see apps/api/.env.example.
# Nothing secret belongs in this file: every VITE_ variable is inlined into the
# browser bundle.
