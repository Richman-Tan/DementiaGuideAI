# Copy to .env (git-ignored). Values mirror the mobile app's EXPO_PUBLIC_* vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: force mock services even when API keys are stored (also: ?mock=1)
VITE_FORCE_MOCK=

# Origin of the backend (the dementiaguide-api Vercel project). REQUIRED in
# production builds; leave unset locally so calls stay relative and the vite dev
# middleware can serve apps/api/api/*. Unset in production the app calls its own
# origin, the SPA rewrite answers with index.html, and every study request fails
# with HTML where JSON should be.
VITE_API_BASE_URL=

# Server-side credentials now live with the backend — see apps/api/.env.example.
# Nothing secret belongs in this file: every VITE_ variable is inlined into the
# browser bundle.
