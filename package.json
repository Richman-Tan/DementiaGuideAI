{
  "name": "dementiaguideai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start -w apps/mobile",
    "android": "npm run android -w apps/mobile",
    "ios": "npm run ios -w apps/mobile",
    "web": "npm run dev -w apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w apps/mobile && npm test -w apps/web && npm test -w apps/api",
    "test:mobile": "npm test -w apps/mobile",
    "test:web": "npm test -w apps/web",
    "test:api": "npm test -w apps/api",
    "test:coverage": "npm run test:coverage:mobile && npm run test:coverage:web && npm run test:coverage:api && node scripts/eval/coverage-summary.mjs",
    "test:coverage:mobile": "cd apps/mobile && npx jest -c jest.coverage.config.js --coverage",
    "test:coverage:web": "npm test -w apps/web -- --coverage",
    "test:coverage:api": "npm test -w apps/api -- --coverage",
    "rag:eval:retrieval": "node scripts/eval/run-retrieval.mjs",
    "rag:eval:generation": "node scripts/eval/run-generation.mjs",
    "rag:eval:safety": "node scripts/eval/safety-checks.mjs",
    "rag:eval:sweep": "node scripts/eval/sweep.mjs",
    "rag:grade": "node scripts/eval/grade-groundedness.mjs",
    "rag:introspect": "node scripts/eval/introspect.mjs",
    "eval:generate": "node scripts/eval/run-generation.mjs",
    "eval:safety-report": "node scripts/eval/safety-report.mjs",
    "eval:judge": "node scripts/eval/judge.mjs",
    "eval:judge:pairwise": "node scripts/eval/judge-pairwise.mjs",
    "eval:human-sheet": "node scripts/eval/human-sheet.mjs",
    "eval:agreement": "node scripts/eval/agreement.mjs",
    "eval:tables": "node scripts/eval/report-tables.mjs",
    "eval:compare-retrieval": "node scripts/eval/compare-retrieval.mjs",
    "eval:phone-allowlist": "node scripts/eval/build-phone-allowlist.mjs",
    "eval:latency:bench": "node scripts/eval/latency/bench-pipeline.mjs",
    "eval:latency:parse": "node scripts/parse-latency.mjs",
    "eval:cost": "node scripts/eval/cost-model.mjs",
    "eval:coverage:summary": "node scripts/eval/coverage-summary.mjs",
    "eval:load:rpc": "node scripts/eval/load/rpc-load.mjs",
    "eval:load:proxy": "node scripts/eval/load/proxy-load.mjs",
    "eval:stt:prepare": ".venv/bin/python scripts/eval/stt/prepare-adress.py",
    "eval:stt:transcribe": "node scripts/eval/stt/transcribe.mjs",
    "eval:stt:wer": "node scripts/eval/stt/wer-report.mjs",
    "eval:stt:perturb": "node scripts/eval/stt/perturb-questions.mjs",
    "lipsync:summarise": "node scripts/lipsync/summarise-testresults.mjs",
    "lipsync:g2p-ablation": "node scripts/lipsync/g2p-ablation.mjs",
    "brand:icons": "node scripts/brand/build-icons.js",
    "study:export": "node scripts/study/export-study-data.mjs",
    "study:analyse": "node scripts/study/analyse-study.mjs",
    "study:safety": "node scripts/study/safety-scan-transcripts.mjs",
    "study:figures": "python3 scripts/study/make-study-figures.py",
    "kb:ingest": "node scripts/ingest/ingest.mjs",
    "kb:ingest:dry": "node scripts/ingest/ingest.mjs --dry-run",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@mozilla/readability": "^0.6.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.5"
  }
}
