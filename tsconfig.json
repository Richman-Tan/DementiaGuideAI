{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["packages/core/*"]
    }
  },
  "include": ["index.js", "App.js", "src/**/*", "packages/**/*"],
  "exclude": ["node_modules", "unity-avatar", "scripts", "modules", "plugins", "dist", ".expo"]
}
